{
  "policy_id": "pytest_suite_classification_v1",
  "schema_version": 1,
  "description": "Ordered file-level pytest classification before physical TESTORG moves.",
  "effective_date": "2026-08-20",
  "default_suite": "unit",
  "ordered_rules": [
    {
      "suite": "production",
      "patterns": [
        "tests/production/test_*.py"
      ]
    },
    {
      "suite": "network",
      "patterns": [
        "tests/integration/network/test_*.py"
      ]
    },
    {
      "suite": "replay",
      "patterns": [
        "tests/replay/test_*.py"
      ]
    },
    {
      "suite": "integration",
      "patterns": [
        "tests/integration/test_*.py"
      ]
    }
  ]
}
